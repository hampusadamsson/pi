{
  "settings": {
    "mcpFooterStatus": "off"
  },
  "mcpServers": {
    "snowflake": {
      "type": "http",
      "url": "https://snowflake-agentic-poc-mcp.data.stage.lendo.dev/mcp",
      "enabled": true,
      "exposure": "hidden",
      "toolExposure": {
        "run_snowflake_query": "direct"
      }
    },
    "humio": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://lendo-group.ghe.com/lendo-data-ml/humio-mcp.git@1.0.0",
        "humio-mcp"
      ],
      "env": {
        "HUMIO_TOKEN": "${HUMIO_TOKEN}",
        "HUMIO_ENDPOINT": "https://lendo.logscale.eu-1.crowdstrike.com"
      },
      "exposure": "hidden",
      "toolExposure": {
        "search": "direct",
        "list_repos": "direct"
      }
    },
    "atlassian": {
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ],
      "env": {
        "CONFLUENCE_URL": "https://lendo-group.atlassian.net/wiki",
        "CONFLUENCE_USERNAME": "hampus.adamsson@group.clar.co",
        "JIRA_URL": "https://lendo-group.atlassian.net",
        "JIRA_USERNAME": "hampus.adamsson@group.clar.co",
        "JIRA_PROJECTS_FILTER": "DATA"
      },
      "exposure": "hidden",
      "toolExposure": {
        "confluence_add_label": "direct",
        "confluence_get_page": "direct",
        "confluence_create_page": "direct",
        "confluence_move_page": "direct",
        "confluence_search": "direct",
        "confluence_update_page_section": "direct",
        "confluence_get_page_children": "direct",
        "confluence_update_page": "direct",
        "confluence_get_space_page_tree": "direct",
        "jira_search": "direct",
        "jira_create_issue": "direct",
        "jira_get_issue": "direct",
        "jira_update_issue": "direct"
      }
    }
  }
}
