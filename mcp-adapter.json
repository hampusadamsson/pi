{
  "settings": {
    "mcpFooterStatus": "off"
  },
  "mcpServers": {
    "mysharedbrain": {
      "type": "remote",
      "url": "https://mysharedbrain.haadpi.duckdns.org:9443/mcp/",
      "caFile": "~/.pi/agent/certs/mysharedbrain.pem",
      "enabled": true
    },
    "snowflake": {
      "type": "remote",
      "url": "https://snowflake-agentic-poc-mcp.data.stage.lendo.dev/mcp",
      "enabled": true
    },
    "humio": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://lendo-group.ghe.com/lendo-data-ml/humio-mcp.git@1.0.0",
        "humio-mcp"
      ],
      "env": {
        "HUMIO_TOKEN": "${HUMIO_TOKEN}",
        "HUMIO_ENDPOINT": "https://lendo.logscale.eu-1.crowdstrike.com"
      }
    },
    "atlassian": {
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ],
      "env": {
        "CONFLUENCE_URL": "https://lendo-group.atlassian.net/wiki",
        "CONFLUENCE_USERNAME": "hampus.adamsson@group.clar.co",
        "JIRA_URL": "https://lendo-group.atlassian.net",
        "JIRA_USERNAME": "hampus.adamsson@group.clar.co",
        "JIRA_PROJECTS_FILTER": "DATA"
      }
    }
  }
}
