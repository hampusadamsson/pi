# Secrets / auth
auth.json
mcp-oauth/
models-store.json
# models.json is NOT a secret here: it holds `"apiKey": "$BIFROST_API_KEY"`,
# a name pi resolves at request time, never a literal key. It is committed on
# purpose so the uipi image (which ships this repo's agent config) gets the
# bifrost provider at all.

# Cache
cache/
mcp-cache.json
mcp-npx-cache.json

# Sessions
sessions/

